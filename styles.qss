/* Carmen Focus — Qt visual language.
   Soft off-white content background, muted/desaturated accent colors,
   8-12px rounded corners, an 8px/16px spacing scale, Segoe UI Variable
   (falling back to Segoe UI) with a clear size hierarchy. Drop shadows are
   NOT here — QSS has no box-shadow equivalent; those are applied in Python
   per-widget via QGraphicsDropShadowEffect (see qt_ui/month_view.py,
   qt_ui/day_view.py). */

* {
    font-family: "Segoe UI Variable", "Segoe UI", sans-serif;
}

QWidget#ContentArea {
    background: #F7F7F8;
}

QWidget#ContentArea QLabel {
    color: #1F2328;
    font-size: 13px;
}

/* Standalone popup windows (dialogs, pickers, viewers) that aren't part of
   the main window's ContentArea -- the enforcer overlay and the delete-undo
   toast intentionally keep their own dark styling (always-on-top over
   arbitrary apps) and don't use this class. */
QWidget#PopupBg {
    background: #F7F7F8;
}

QWidget#PopupBg QLabel,
QWidget#PopupBg QCheckBox,
QWidget#PopupBg QRadioButton {
    color: #1F2328;
    font-size: 13px;
}

QWidget#PopupBg QLineEdit,
QWidget#PopupBg QTextEdit,
QWidget#PopupBg QComboBox,
QWidget#PopupBg QListWidget {
    background: #FAFBFC;
    border: 1px solid #E3E5E9;
    border-radius: 8px;
    padding: 4px 6px;
    color: #1F2328;
}

QWidget#PopupBg QPushButton {
    background: #F1F3F6;
    color: #1F2328;
    border: none;
    border-radius: 8px;
    padding: 6px 14px;
}

QWidget#PopupBg QPushButton:hover {
    background: #E6E9EE;
}

QWidget#PopupBg QPushButton.AccentButton {
    background: #5B8DEF;
    color: white;
    font-weight: 600;
}

QWidget#PopupBg QPushButton.AccentButton:hover {
    background: #4A7CDE;
}

QWidget#Sidebar {
    background: #20242C;
}

QLabel#SidebarTitle {
    color: #E8EAED;
    font-size: 14px;
    font-weight: 600;
    padding: 22px 18px 20px 18px;
}

QPushButton.NavButton {
    background: transparent;
    color: #C7CAD3;
    border: none;
    border-radius: 8px;
    text-align: left;
    padding: 9px 14px;
    font-size: 13px;
    margin: 0px 12px;
}

QPushButton.NavButton:hover {
    background: #2B3140;
}

QPushButton.NavButton:checked {
    background: #3A4256;
    color: #FFFFFF;
    font-weight: 600;
}

QPushButton.SecondaryButton {
    background: #F1F3F6;
    color: #1F2328;
    border: none;
    border-radius: 8px;
    padding: 7px 14px;
    font-size: 12px;
}

QPushButton.SecondaryButton:hover {
    background: #E6E9EE;
}

/* Checkable SecondaryButtons used as toggle pairs (Review tab's Due/All
   filter) -- without this, a checked and unchecked toggle button look
   identical since SecondaryButton itself has no :checked rule. */
QPushButton.SecondaryButton:checked {
    background: #5B8DEF;
    color: #FFFFFF;
    font-weight: 600;
}

/* "Until I burnout" toggle on a task's Start overlay -- dark red by default
   so the option pops out as a distinct, deliberate choice (not just another
   gray SecondaryButton) even before it's clicked; checked state brightens
   further so the armed/committed state still reads unmistakably. A task's
   own card can itself be a red pastel fill (task color picked as red), which
   made a borderless red button blend straight into the card background --
   the white border guarantees an edge against any card color, not just the
   ones that happen to contrast with red. */
QPushButton#burnoutButton {
    background: #A93226;
    color: #FFFFFF;
    border: 2px solid #FFFFFF;
}

QPushButton#burnoutButton:hover {
    background: #922B1F;
}

QPushButton#burnoutButton:checked {
    background: #E74C3C;
    color: #FFFFFF;
}

QPushButton#burnoutButton:checked:hover {
    background: #D64031;
}

/* Start Task button on a task's Start overlay -- black text on a green
   outline (not filled), since the shared .AccentButton fill made the white
   text unreadable against this card's own background. */
QPushButton#startTaskButton {
    background: #FFFFFF;
    color: #1F2328;
    border: 2px solid #2E8B57;
    border-radius: 8px;
    padding: 6px 13px;
    font-weight: 600;
}

QPushButton#startTaskButton:hover {
    background: #EAF6EF;
}

QPushButton.AccentButton {
    background: #5B8DEF;
    color: white;
    border: none;
    border-radius: 8px;
    padding: 7px 16px;
    font-size: 12px;
    font-weight: 600;
}

QPushButton.AccentButton:hover {
    background: #4A7CDE;
}

QLabel#MonthLabel {
    font-size: 24px;
    font-weight: 700;
    color: #1F2328;
}

QLineEdit#SearchBox {
    background: #FAFBFC;
    border: 1px solid #E3E5E9;
    border-radius: 8px;
    padding: 7px 10px;
    font-size: 13px;
    color: #1F2328;
}

QLineEdit#SearchBox:focus {
    border: 1px solid #5B8DEF;
}

QFrame.DayCell {
    background: #FFFFFF;
    border: 1px solid #ECEEF1;
    border-radius: 10px;
}

QFrame.DayCell[isToday="true"] {
    background: #EAF2FF;
    border: 1px solid #5B8DEF;
}

QFrame.DayCell[isSelected="true"] {
    background: #F1F3F6;
    border: 1px solid #C9CCD3;
}

QFrame.DayCell[inMonth="false"] {
    background: #FAFBFC;
}

QFrame.DayCell:hover {
    border: 1px solid #5B8DEF;
}

QLabel.DayNumber {
    color: #1F2328;
    font-size: 13px;
    font-weight: 600;
    padding: 4px 6px;
}

QLabel.DayNumber[isToday="true"] {
    color: #5B8DEF;
}

QLabel.DayNumber[inMonth="false"] {
    color: #C7CAD3;
}

QLabel.WeekdayHeader {
    color: #8A8F98;
    font-size: 11px;
    font-weight: 700;
    padding: 8px 0px;
}

QLabel.EventPill {
    color: white;
    font-size: 11px;
    border-radius: 8px;
    padding: 2px 8px;
    margin: 1px 4px;
}

QLabel.OverflowLabel {
    color: #8A8F98;
    font-size: 10px;
    padding: 0px 6px;
}

QSplitter::handle {
    background: #E3E5E9;
}

QSplitter::handle:hover {
    background: #5B8DEF;
}

QSplitter::handle:vertical {
    height: 6px;
}

QFrame.TaskCard {
    /* Background is set per-card in tasks_tab.py (tinted with the task's
       own color) via an instance stylesheet, which takes precedence over
       this rule -- this is just the fallback/border. */
    background: #FFFFFF;
    border: 1px solid #ECEEF1;
    border-radius: 12px;
}

QFrame.TaskCard:hover {
    border: 1px solid #5B8DEF;
}

QFrame.TaskCard[locked="true"] {
    background: #FAFBFC;
    border: 1px solid #ECEEF1;
}

QWidget#TasksGridBg {
    background: #FFFFFF;
}

QPushButton.TaskDescriptionButton {
    text-align: left;
    border: none;
    background: transparent;
    padding: 0;
    color: #3A3F48;
    font-size: 13px;
}

QPushButton.TaskDescriptionButton:hover {
    color: #1F2328;
    text-decoration: underline;
}

QProgressBar.TaskProgressBar {
    background: #F1F3F6;
    border: none;
    border-radius: 5px;
}

QProgressBar.TaskProgressBar::chunk {
    border-radius: 5px;
}

/* Start button in the Review tab's problem table -- flat blue text, no
   border/box. The row's pastel tint already identifies the subject, so a
   border-style button adds visual noise. */
QPushButton#reviewStartButton {
    background: transparent;
    color: #5B8DEF;
    border: none;
    border-radius: 6px;
    padding: 4px 10px;
    font-size: 12px;
    font-weight: 600;
}

QPushButton#reviewStartButton:hover {
    background: rgba(91, 141, 239, 0.12);
}

/* Review tab's topic tabs (qt_ui/review_tab.py) -- browser/chrome-style tab
   strip, including the trailing "+" tab (styled the same as any other tab;
   review_tab.py intercepts clicks on it rather than actually showing it as
   a page). */
QTabWidget::pane {
    border: none;
    background: #FFFFFF;
}

QTabBar::tab {
    background: #F1F3F6;
    color: #5A6070;
    border: none;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    padding: 8px 18px;
    margin-right: 4px;
    font-size: 13px;
}

QTabBar::tab:selected {
    background: #FFFFFF;
    color: #1F2328;
    font-weight: 600;
}

QTabBar::tab:hover {
    background: #E6E9EE;
}

QTableWidget {
    background: #FFFFFF;
    border: 1px solid #ECEEF1;
    border-radius: 8px;
    gridline-color: #ECEEF1;
}

QHeaderView::section {
    background: #F7F7F8;
    color: #5A6070;
    border: none;
    border-bottom: 1px solid #ECEEF1;
    padding: 6px 8px;
    font-size: 11px;
    font-weight: 700;
}

/* Review tab's problem table (qt_ui/review_tab.py) needs a clearly visible
   horizontal scrollbar when the window is too narrow to show every column --
   the default QSS-rendered scrollbar (once any global QSS rule applies,
   Qt stops using the native Windows scrollbar and falls back to an
   unstyled, barely-visible flat line unless explicitly styled here). */
QTableWidget QScrollBar:horizontal {
    height: 14px;
    background: #F1F3F6;
    border-radius: 7px;
    margin: 2px 2px 0px 2px;
}

QTableWidget QScrollBar::handle:horizontal {
    background: #C7CAD3;
    min-width: 30px;
    border-radius: 6px;
}

QTableWidget QScrollBar::handle:horizontal:hover {
    background: #5B8DEF;
}

QTableWidget QScrollBar::add-line:horizontal,
QTableWidget QScrollBar::sub-line:horizontal {
    width: 0px;
    border: none;
    background: none;
}

QTableWidget QScrollBar::add-page:horizontal,
QTableWidget QScrollBar::sub-page:horizontal {
    background: none;
}

/* Inline "+ Add Subject" mini-form inside the Add Problem dialog
   (qt_ui/review_tab.py's _AddProblemDialog). */
QFrame.InlineForm {
    background: #FAFBFC;
    border: 1px solid #E3E5E9;
    border-radius: 8px;
    padding: 8px;
}
