/* Carmen Focus — Qt visual language.
   Soft off-white content background, muted/desaturated accent colors,
   8-12px rounded corners, an 8px/16px spacing scale, Segoe UI Variable
   (falling back to Segoe UI) with a clear size hierarchy. Drop shadows are
   NOT here — QSS has no box-shadow equivalent; those are applied in Python
   per-widget via QGraphicsDropShadowEffect (see qt_ui/month_view.py,
   qt_ui/day_view.py). */

* {
    font-family: "Segoe UI Variable", "Segoe UI", sans-serif;
}

QWidget#ContentArea {
    background: #F7F7F8;
}

QWidget#ContentArea QLabel {
    color: #1F2328;
    font-size: 13px;
}

/* Dialogs opened from a tab (message boxes, input/colour dialogs) are children of
   ContentArea too, so the rule above gave their text the same dark colour -- invisible
   on a dark-mode dialog. Put them back on the dialog's own text colour. */
QWidget#ContentArea QDialog QLabel {
    color: palette(window-text);
}

/* Standalone popup windows (dialogs, pickers, viewers) that aren't part of
   the main window's ContentArea -- the enforcer overlay and the delete-undo
   toast intentionally keep their own dark styling (always-on-top over
   arbitrary apps) and don't use this class.

   One look for all of them: a white sheet, a title (and a line under it), small grey field
   labels, soft grey inputs that turn white with an ink outline when focused, ink primary
   buttons, grey secondary ones. Labels pick their role from a "role" property: title,
   subtitle, field, hint, error (qt_ui/ui_kit.py: dialog_title, field_label). */
QWidget#PopupBg {
    background: #FFFFFF;
}

QWidget#PopupBg QLabel,
QWidget#PopupBg QCheckBox,
QWidget#PopupBg QRadioButton {
    color: #1B2230;
    font-size: 13px;
    background: transparent;
}

QWidget#PopupBg QLabel[role="title"] {
    font-size: 21px;
    font-weight: 700;
}

QWidget#PopupBg QLabel[role="subtitle"] {
    font-size: 13px;
    color: #667085;
}

QWidget#PopupBg QLabel[role="field"] {
    font-size: 12.5px;
    font-weight: 650;
    color: #667085;
}

QWidget#PopupBg QLabel[role="hint"] {
    font-size: 12px;
    color: #98A2B3;
}

QWidget#PopupBg QLabel[role="error"] {
    font-size: 12.5px;
    color: #B42318;
}

QWidget#PopupBg QLineEdit,
QWidget#PopupBg QTextEdit,
QWidget#PopupBg QPlainTextEdit,
QWidget#PopupBg QComboBox,
QWidget#PopupBg QSpinBox,
QWidget#PopupBg QDoubleSpinBox,
QWidget#PopupBg QListWidget {
    background: #F7F8FA;
    border: 1px solid #E6E9EF;
    border-radius: 10px;
    padding: 7px 10px;
    color: #1B2230;
    font-size: 13.5px;
    selection-background-color: #1B2230;
    selection-color: #FFFFFF;
    placeholder-text-color: #98A2B3;
}

QWidget#PopupBg QLineEdit:focus,
QWidget#PopupBg QComboBox:focus,
QWidget#PopupBg QSpinBox:focus {
    background: #FFFFFF;
    border: 1.5px solid #1B2230;
}

/* Text areas keep their fill on focus: their inner viewport would not follow the change and a
   lighter rectangle would show inside the outline. */
QWidget#PopupBg QTextEdit:focus,
QWidget#PopupBg QPlainTextEdit:focus {
    border: 1.5px solid #1B2230;
}

QWidget#PopupBg QComboBox::drop-down {
    border: none;
    width: 26px;
}

/* The dropdown list a QComboBox pops open is a separate top-level widget,
   not a descendant of #PopupBg -- the "#PopupBg QComboBox" rule above only
   styles the closed box itself, so without this the popup list falls back
   to the OS theme and can render white-on-white (invisible) text on a
   dark-mode Windows install. Applies globally since every combo box in the
   app (subject picker, task-link picker, etc.) needs the same fix. */
QComboBox QAbstractItemView {
    background: #FFFFFF;
    color: #1B2230;
    border: 1px solid #E6E9EF;
    selection-background-color: #1B2230;
    selection-color: #FFFFFF;
    outline: none;
    padding: 4px;
}

QWidget#PopupBg QPushButton {
    background: #F2F4F7;
    color: #1B2230;
    border: none;
    border-radius: 10px;
    padding: 8px 16px;
    font-size: 13px;
    font-weight: 600;
}

QWidget#PopupBg QPushButton:hover {
    background: #E7EAF0;
}

QWidget#PopupBg QPushButton:disabled {
    background: #F2F4F7;
    color: #A3ABB8;
}

QWidget#PopupBg QPushButton.AccentButton {
    background: #1B2230;
    color: #FFFFFF;
    font-weight: 600;
}

QWidget#PopupBg QPushButton.AccentButton:hover {
    background: #2B3445;
}

QWidget#PopupBg QPushButton.AccentButton:disabled {
    background: #EEF0F4;
    color: #A3ABB8;
}

QWidget#PopupBg QPushButton.DangerButton {
    background: #FEF3F2;
    color: #B42318;
}

QWidget#PopupBg QPushButton.DangerButton:hover {
    background: #FEE4E2;
}

/* Without this, QWidget#PopupBg QPushButton's plain background rule above
   (an ID selector) outranks QPushButton.SecondaryButton:checked's fill
   (class + pseudo, no ID) -- a checked day-of-week/recurrence toggle inside
   a popup dialog would keep its bold text but lose the fill entirely. */
QWidget#PopupBg QPushButton.SecondaryButton:checked,
QWidget#PopupBg QPushButton:checked {
    background: #1B2230;
    color: #FFFFFF;
    font-weight: 600;
}

QWidget#PopupBg QRadioButton {
    spacing: 8px;
}

QWidget#PopupBg QRadioButton::indicator {
    width: 16px;
    height: 16px;
    border: 1.5px solid #B8BFCC;
    border-radius: 9px;
    background: #FFFFFF;
}

QWidget#PopupBg QRadioButton::indicator:checked {
    border: 1.5px solid #1B2230;
    background: qradialgradient(cx: 0.5, cy: 0.5, radius: 0.5, fx: 0.5, fy: 0.5,
        stop: 0 #1B2230, stop: 0.45 #1B2230, stop: 0.55 #FFFFFF, stop: 1 #FFFFFF);
}

QWidget#PopupBg QTabWidget::pane {
    border: none;
    background: transparent;
}

QWidget#PopupBg QTabBar::tab {
    background: #F2F4F7;
    color: #667085;
    border-radius: 12px;
    padding: 7px 18px;
    margin: 0 6px 10px 0;
    font-size: 13px;
    font-weight: 600;
}

QWidget#PopupBg QTabBar::tab:selected {
    background: #1B2230;
    color: #FFFFFF;
}

QWidget#PopupBg QTabBar::tab:hover:!selected {
    background: #E7EAF0;
}

QWidget#PopupBg QScrollBar:vertical {
    width: 10px;
    background: transparent;
    margin: 2px;
}

QWidget#PopupBg QScrollBar::handle:vertical {
    background: #D0D5DD;
    border-radius: 4px;
    min-height: 28px;
}

QWidget#PopupBg QScrollBar::add-line:vertical,
QWidget#PopupBg QScrollBar::sub-line:vertical {
    height: 0;
}

/* Message boxes (confirmations, warnings) and anything else the app pops up through Qt's
   standard dialogs: a white sheet, ink text, the same buttons. They are children of the main
   window, so spell the colours out instead of inheriting ContentArea's. */
QMessageBox,
QInputDialog,
QColorDialog,
QFileDialog {
    background: #FFFFFF;
}

QMessageBox QLabel,
QInputDialog QLabel {
    color: #1B2230;
    font-size: 14px;
    background: transparent;
}

QMessageBox QPushButton,
QInputDialog QPushButton {
    background: #F2F4F7;
    color: #1B2230;
    border: none;
    border-radius: 10px;
    padding: 8px 20px;
    min-width: 76px;
    font-size: 13px;
    font-weight: 600;
}

QMessageBox QPushButton:hover,
QInputDialog QPushButton:hover {
    background: #E7EAF0;
}

QMessageBox QPushButton:default,
QInputDialog QPushButton:default {
    background: #1B2230;
    color: #FFFFFF;
}

QInputDialog QLineEdit {
    background: #F7F8FA;
    border: 1px solid #E6E9EF;
    border-radius: 10px;
    padding: 7px 10px;
    color: #1B2230;
}

QToolTip {
    background: #1B2230;
    color: #FFFFFF;
    border: none;
    padding: 6px 9px;
    font-size: 12.5px;
}

QWidget#Sidebar {
    background: #20242C;
}

QLabel#SidebarTitle {
    color: #E8EAED;
    font-size: 14px;
    font-weight: 600;
    padding: 22px 18px 20px 18px;
}

QPushButton.NavButton {
    background: transparent;
    color: #C7CAD3;
    border: none;
    border-radius: 8px;
    text-align: left;
    padding: 9px 14px;
    font-size: 13px;
    margin: 0px 12px;
}

QPushButton.NavButton:hover {
    background: #2B3140;
}

QPushButton.NavButton:checked {
    background: #3A4256;
    color: #FFFFFF;
    font-weight: 600;
}

QPushButton.SecondaryButton {
    background: #F1F3F6;
    color: #1F2328;
    border: none;
    border-radius: 8px;
    padding: 7px 14px;
    font-size: 12px;
}

QPushButton.SecondaryButton:hover {
    background: #E6E9EE;
}

/* Checkable SecondaryButtons used as toggle pairs (Review tab's Due/All
   filter) -- without this, a checked and unchecked toggle button look
   identical since SecondaryButton itself has no :checked rule. */
QPushButton.SecondaryButton:checked {
    background: #5B8DEF;
    color: #FFFFFF;
    font-weight: 600;
}

QPushButton.AccentButton {
    background: #5B8DEF;
    color: white;
    border: none;
    border-radius: 8px;
    padding: 7px 16px;
    font-size: 12px;
    font-weight: 600;
}

QPushButton.AccentButton:hover {
    background: #4A7CDE;
}

QLabel#MonthLabel {
    font-size: 24px;
    font-weight: 700;
    color: #1F2328;
}

QLineEdit#SearchBox {
    background: #FAFBFC;
    border: 1px solid #E3E5E9;
    border-radius: 8px;
    padding: 7px 10px;
    font-size: 13px;
    color: #1F2328;
}

QLineEdit#SearchBox:focus {
    border: 1px solid #5B8DEF;
}

QFrame.DayCell {
    background: #FFFFFF;
    border: 1px solid #ECEEF1;
    border-radius: 10px;
}

QFrame.DayCell[isToday="true"] {
    background: #EAF2FF;
    border: 1px solid #5B8DEF;
}

QFrame.DayCell[isSelected="true"] {
    background: #F1F3F6;
    border: 1px solid #C9CCD3;
}

QFrame.DayCell[inMonth="false"] {
    background: #FAFBFC;
}

QFrame.DayCell:hover {
    border: 1px solid #5B8DEF;
}

QLabel.DayNumber {
    color: #1F2328;
    font-size: 13px;
    font-weight: 600;
    padding: 4px 6px;
}

QLabel.DayNumber[isToday="true"] {
    color: #5B8DEF;
}

QLabel.DayNumber[inMonth="false"] {
    color: #C7CAD3;
}

QLabel.WeekdayHeader {
    color: #8A8F98;
    font-size: 11px;
    font-weight: 700;
    padding: 8px 0px;
}

QLabel.EventPill {
    color: white;
    font-size: 11px;
    border-radius: 8px;
    padding: 2px 8px;
    margin: 1px 4px;
}

QLabel.OverflowLabel {
    color: #8A8F98;
    font-size: 10px;
    padding: 0px 6px;
}

QSplitter::handle {
    background: #E3E5E9;
}

QSplitter::handle:hover {
    background: #5B8DEF;
}

QSplitter::handle:vertical {
    height: 6px;
}

QPushButton.TaskDescriptionButton {
    text-align: left;
    border: none;
    background: transparent;
    padding: 0;
    color: #3A3F48;
    font-size: 13px;
}

QPushButton.TaskDescriptionButton:hover {
    color: #1F2328;
    text-decoration: underline;
}

/* Start button in the Review tab's problem table -- flat blue text, no
   border/box. The row's pastel tint already identifies the subject, so a
   border-style button adds visual noise. */
QPushButton#reviewStartButton {
    background: transparent;
    color: #5B8DEF;
    border: none;
    border-radius: 6px;
    padding: 4px 10px;
    font-size: 12px;
    font-weight: 600;
}

QPushButton#reviewStartButton:hover {
    background: rgba(91, 141, 239, 0.12);
}

QPushButton#reviewStartButton:disabled {
    background: transparent;
    color: #A8AEB7;
}

/* Review tab's topic tabs (qt_ui/review_tab.py) -- browser/chrome-style tab
   strip, including the trailing "+" tab (styled the same as any other tab;
   review_tab.py intercepts clicks on it rather than actually showing it as
   a page). */
QTabWidget::pane {
    border: none;
    background: #FFFFFF;
}

QTabBar::tab {
    background: #F1F3F6;
    color: #5A6070;
    border: none;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    padding: 8px 18px;
    margin-right: 4px;
    font-size: 13px;
}

QTabBar::tab:selected {
    background: #FFFFFF;
    color: #1F2328;
    font-weight: 600;
}

QTabBar::tab:hover {
    background: #E6E9EE;
}

QTableWidget {
    background: #FFFFFF;
    border: 1px solid #ECEEF1;
    border-radius: 8px;
    gridline-color: #ECEEF1;
}

QHeaderView::section {
    background: #F7F7F8;
    color: #5A6070;
    border: none;
    border-bottom: 1px solid #ECEEF1;
    padding: 6px 8px;
    font-size: 11px;
    font-weight: 700;
}

/* Review tab's problem table (qt_ui/review_tab.py) needs a clearly visible
   horizontal scrollbar when the window is too narrow to show every column --
   the default QSS-rendered scrollbar (once any global QSS rule applies,
   Qt stops using the native Windows scrollbar and falls back to an
   unstyled, barely-visible flat line unless explicitly styled here). */
QTableWidget QScrollBar:horizontal {
    height: 14px;
    background: #F1F3F6;
    border-radius: 7px;
    margin: 2px 2px 0px 2px;
}

QTableWidget QScrollBar::handle:horizontal {
    background: #C7CAD3;
    min-width: 30px;
    border-radius: 6px;
}

QTableWidget QScrollBar::handle:horizontal:hover {
    background: #5B8DEF;
}

QTableWidget QScrollBar::add-line:horizontal,
QTableWidget QScrollBar::sub-line:horizontal {
    width: 0px;
    border: none;
    background: none;
}

QTableWidget QScrollBar::add-page:horizontal,
QTableWidget QScrollBar::sub-page:horizontal {
    background: none;
}

/* Inline "+ Add Subject" mini-form inside the Add Problem dialog
   (qt_ui/review_tab.py's _AddProblemDialog). */
QFrame.InlineForm {
    background: #FAFBFC;
    border: 1px solid #E3E5E9;
    border-radius: 8px;
    padding: 8px;
}

QFrame.BoardCard {
    background: #FFFFFF;
    border: 1px solid #E6E9EF;
    border-radius: 16px;
}

QFrame.BoardCard:hover {
    border: 1px solid #C9CED8;
}

/* Every checkbox, everywhere: a green box with a white tick when checked. @CHECK@ is
   replaced with the path of the tick picture when the stylesheet is loaded
   (qt_ui/ui_kit.py: with_check_icon). */
QCheckBox::indicator,
QListView::indicator,
QMenu::indicator {
    width: 16px;
    height: 16px;
    border: 1.5px solid #B8BFCC;
    border-radius: 5px;
    background: #FFFFFF;
}

QCheckBox::indicator:hover,
QListView::indicator:hover {
    border-color: #2F9E44;
}

QCheckBox::indicator:checked,
QListView::indicator:checked,
QMenu::indicator:checked {
    background: #2F9E44;
    border-color: #2F9E44;
    image: url(@CHECK@);
}

QCheckBox::indicator:checked:hover,
QListView::indicator:checked:hover {
    background: #278A3B;
    border-color: #278A3B;
}

QCheckBox::indicator:disabled {
    background: #EEF0F4;
    border-color: #D5D9E0;
}

QMenu::indicator {
    margin-left: 6px;
}
