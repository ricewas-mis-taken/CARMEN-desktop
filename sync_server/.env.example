# sync_server reads these from ../private/.env (the same file the main
# desktop app uses) -- this file just documents what's required. The real
# .env stays gitignored; never commit real values.
SUPABASE_URL=your-project-url-here
SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here
SUPABASE_JWKS_URL=your-jwks-url-here
